{
  "name": "pomodoro-tomate",
  "productName": "Pomodoro Tomate",
  "version": "1.0.0",
  "description": "Minuteur Pomodoro en forme de tomate",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.tomate.pomodoro",
    "productName": "Pomodoro Tomate",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "icon.png",
      "icon-256.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.png",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png",
      "category": "Utility"
    }
  }
}
